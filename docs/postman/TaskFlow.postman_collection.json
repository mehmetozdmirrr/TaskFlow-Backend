{
  "info": {
    "_postman_id": "6f2b6b1a-9a3e-4a3c-9d0a-2f6a2f9a1b10",
    "name": "TaskFlow API",
    "description": "Verification collection for the TaskFlow REST API (Express + JSON file persistence, no auth). Base URL is a collection variable. Run folders top to bottom: CRUD, Advanced Listing, Reports, Validation and Errors, Persistence Verification, then Cleanup - Remove Seed Data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "seedId1", "value": "", "type": "string" },
    { "key": "seedId2", "value": "", "type": "string" },
    { "key": "seedId3", "value": "", "type": "string" },
    { "key": "seedId4", "value": "", "type": "string" },
    { "key": "seedId5", "value": "", "type": "string" },
    { "key": "persistTaskId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend endpointlerini tamamla\",\n  \"description\": \"Task CRUD endpointlerini geliştir ve Postman ile doğrula.\",\n  \"priority\": \"high\",\n  \"assignee\": \"Mehmet Ozdemir\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Response has success true and a data object', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data.status).to.eql('pending');",
                  "});",
                  "pm.collectionVariables.set('taskId', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Response has data array and meta object', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.meta).to.have.all.keys('total', 'page', 'limit', 'totalPages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Returned task matches taskId', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(String(json.data.id)).to.eql(pm.collectionVariables.get('taskId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend endpointlerini tamamla ve doğrula\",\n  \"description\": \"Task CRUD endpointlerini geliştir, Postman ile doğrula ve sonucu kaydet.\",\n  \"priority\": \"medium\",\n  \"assignee\": \"Mehmet Ozdemir\",\n  \"status\": \"in-progress\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Task updated with new status and priority', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.status).to.eql('in-progress');",
                  "  pm.expect(json.data.priority).to.eql('medium');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Deleted task is returned in data', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(String(json.data.id)).to.eql(pm.collectionVariables.get('taskId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
